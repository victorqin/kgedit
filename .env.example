# ---------------------------------------------------------------------------
# 构建期配置。复制为 .env.local 可覆盖本地默认值。
# ---------------------------------------------------------------------------

# 接口基地址。CI/CD 可在构建时注入，例如：
#   VITE_API_BASE_URL=https://kg.example.com/api npm run build
# 但更推荐用运行期配置（见 public/config.js），那样构建一次即可部署到任意环境。
VITE_API_BASE_URL=/api

# 置为 true 时启动 MSW，全部接口走本地内存图数据库。
# 业务代码完全不感知：axios、拦截器、错误信封在两种模式下一致。
VITE_USE_MOCK=true
